{
  "name": "@bukowski/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BukowskiOS desktop operations workspace",
  "author": "BukowskiOS",
  "type": "module",
  "main": "dist-electron/app.js",
  "scripts": {
    "dev": "vite",
    "clean:build": "node ./build/clean-build-output.cjs dist dist-electron",
    "clean:package": "node ./build/clean-build-output.cjs dist-packaged",
    "verify:package-env": "node ./build/verify-package-env.cjs",
    "build": "pnpm clean:build && vite build",
    "rebuild:electron": "mkdir -p \"${TMPDIR:-/tmp}/bukowski-electron-home\" && HOME=\"${TMPDIR:-/tmp}/bukowski-electron-home\" npm_config_devdir=\"${TMPDIR:-/tmp}/bukowski-electron-home/.electron-gyp\" electron-rebuild -f -w better-sqlite3",
    "package:internal": "pnpm verify:package-env && pnpm clean:package && pnpm build && pnpm rebuild:electron && electron-builder --config electron-builder.config.cjs --publish never",
    "package:mac": "pnpm verify:package-env && pnpm clean:package && pnpm build && pnpm rebuild:electron && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:mac:release": "pnpm verify:package-env && pnpm clean:package && pnpm build && pnpm rebuild:electron && BUKOWSKI_RELEASE_SIGNING=1 electron-builder --config electron-builder.config.cjs --mac --publish never",
    "release:github": "pnpm verify:package-env && pnpm clean:package && pnpm build && pnpm rebuild:electron && BUKOWSKI_RELEASE_SIGNING=1 electron-builder --config electron-builder.config.cjs --mac --publish always",
    "verify:mac-build": "node ./build/verify-macos-build.cjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test -c playwright.electron.config.ts",
    "test:e2e:perf": "pnpm build && BUKOWSKI_PROFILE_DATASET=1 playwright test -c playwright.electron.config.ts e2e/perf",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.2",
    "better-sqlite3": "^12.8.0",
    "bwip-js": "^4.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dinero.js": "^2.0.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.511.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.1.3"
  }
}
