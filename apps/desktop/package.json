{
  "name": "@bukowski/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "BukowskiOS desktop operations workspace",
  "author": "BukowskiOS",
  "type": "module",
  "main": "dist-electron/app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "rebuild:electron": "mkdir -p \"${TMPDIR:-/tmp}/bukowski-electron-home\" && HOME=\"${TMPDIR:-/tmp}/bukowski-electron-home\" npm_config_devdir=\"${TMPDIR:-/tmp}/bukowski-electron-home/.electron-gyp\" electron-rebuild -f -w better-sqlite3",
    "package:internal": "pnpm build && pnpm rebuild:electron && electron-builder --config electron-builder.config.cjs --publish never",
    "package:mac": "pnpm build && pnpm rebuild:electron && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:mac:release": "pnpm build && pnpm rebuild:electron && BUKOWSKI_RELEASE_SIGNING=1 electron-builder --config electron-builder.config.cjs --mac --publish never",
    "release:github": "pnpm build && pnpm rebuild:electron && BUKOWSKI_RELEASE_SIGNING=1 electron-builder --config electron-builder.config.cjs --mac --publish always",
    "verify:mac-build": "node ./build/verify-macos-build.cjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test -c playwright.electron.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bwip-js": "^4.9.0",
    "lucide-react": "^0.511.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.1.3"
  }
}
